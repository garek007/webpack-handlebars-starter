     <!DOCTYPE html>
     <html>
     <head>
         <title>{{htmlWebpackplugin.options.title}}</title>
     </head>
     <body>
        {{myVariable}}
         <h1>Hello, {{name}}!</h1>
         {{> field/input name="dename" label="Data Extension Name" type="text"}}

         {{> field/input name="upload" label="Upload CSV" type="upload"}}
        <div class="slds-grid">
            {{#> col }}
                {{> field/input name="FirstName" label="First Name" type="text"}}
            {{/col}}
            {{#> col }}
                {{> field/input name="LastName" label="Last Name" type="text"}}
            {{/col}}
            {{#> col }}
                {{> field/input name="Email" label="Email" type="EmailAddress"}}
          
            {{/col}}
         
        </div>


         <ul>
             {{#each items}}
                 <li>{{this}}</li>
             {{/each}}
         </ul>
         {{test}}
     </body>
     </html>